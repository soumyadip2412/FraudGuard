# Copy to .env and adjust. docker-compose.yml and the API both read this file.

# Required X-API-Key header value for /predictions and /transactions. Empty = auth off.
API_KEY=

# Password for the PostgreSQL container (docker compose). Change it for any shared machine.
POSTGRES_PASSWORD=fraudguard

# Database for a locally run API (uvicorn). Start PostgreSQL with: docker compose up -d db
# Leave unset to fall back to a local SQLite file (fraudguard.db).
DATABASE_URL=postgresql+psycopg2://fraudguard:fraudguard@127.0.0.1:5432/fraudguard

# Empty serves ml/artifacts/model.joblib; logreg_ serves logreg_model.joblib (use ?explain=false)
ARTIFACT_PREFIX=

# Number of SHAP reasons returned per prediction
EXPLAIN_TOP_K=5
